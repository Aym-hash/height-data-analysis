import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. データの読み込みと列名の確認
# 作成したサンプルCSVを読み込み
df = pd.read_csv("sample_heights.csv")

# KeyError防止のため事前に列名（カラム名）を出力して確認
print(df.columns)

#2. 特定グループ（Group@）の抽出と要約統計量の集計
#Group@ を抽出
target_group_name = 'Group@'
gf = df[df['所属'].str.contains(target_group_name, na=False)]

# pd.Series を用いて主要な要約統計量をまとめて作成
stats = pd.Series({
    '人数 (N)': len(gf),
    '平均値 (Mean)': gf['身長(cm)'].mean(),
    '標準偏差 (SD)': gf['身長(cm)'].std(),
    '中央値 (Median)': gf['身長(cm)'].median(),
    '最小値 (Min)': gf['身長(cm)'].min(),
    '最大値 (Max)': gf['身長(cm)'].max(),
    '四分位範囲 (IQR)': gf['身長(cm)'].quantile(0.75) - gf['身長(cm)'].quantile(0.25),
    '最小値サンプル': gf.loc[gf['身長(cm)'].idxmin(), '名前'],
    '最大値サンプル': gf.loc[gf['身長(cm)'].idxmax(), '名前'],
})

# to_string() を使ってフォーマットの崩れを防ぎ出力
print(stats.to_string())

# 3. ヒストグラムおよび比較用補助線の描画
# 日本語文字化け（豆腐化）対策（Windows標準フォント指定）
plt.rcParams['font.family'] = 'MS Gothic'

plt.figure(figsize=(10, 5))

# Seabornによるヒストグラムとカーネル密度推定（KDE）描画
sns.histplot(df['身長(cm)'], bins=15, kde=True, color='skyblue')

# 比較用垂直線の追加 (※ 凡例反映のため plt.legend() より前に記述)
plt.axvline(df['身長(cm)'].mean(), color='red', linestyle='--', label=f"全体平均 ({df['身長(cm)'].mean():.1f}cm)")
plt.axvline(gf['身長(cm)'].mean(), color='green', linestyle='-', label=f"{target_group_name}平均 ({gf['身長(cm)'].mean():.1f}cm)")

# ターゲット値（比較対象）の描画
target_value = 161.0
plt.axvline(target_value, color='orange', linestyle=':', linewidth=2, label=f"ターゲット値 ({target_value:.1f}cm)")

# 装飾
plt.title("グループ別身長分布ヒストグラム")
plt.xlabel("身長 (cm)")
plt.ylabel("人数")

# 凡例・保存・表示 (plt.savefig は plt.show の前に配置)
plt.legend()
plt.savefig("sample_height_histogram.png", dpi=300, bbox_inches='tight')
plt.show()
